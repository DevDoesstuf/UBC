{
  "name": "huddle",
  "version": "0.1.0",
  "private": true,
  "description": "Huddle: watch-party prediction market. Kiosk + phones + watch page, one Vercel site.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lan": "next build && next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/register.mjs --test test/*.test.mts",
    "test:localnet": "node --import ./test/register.mjs --test test/solana-localnet.e2e.mts",
    "solana:setup": "node scripts/solana-setup.mjs",
    "solana:wallet": "node scripts/solana-wallet.mjs",
    "test:vault-localnet": "node --import ./test/register.mjs --test --test-concurrency=1 test/vault-localnet.e2e.mts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.62.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3"
  }
}
