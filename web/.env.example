# Copy to .env.local for local dev, or add these in Vercel > Project > Settings > Environment Variables.
# Nothing here is required for the demo: with no env vars the site runs in demo mode with in-memory storage.

# ---------- Storage (REQUIRED on Vercel) ----------
# Add "Upstash for Redis" from the Vercel Marketplace and connect it to the project; it sets these for you.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# ---------- Public address ----------
# Optional. Used for QR codes and Coinbase redirects when phones reach the site by a different name
# than the device that asked (e.g. testing on a laptop over a phone hotspot: http://192.168.43.10:3000).
# PUBLIC_BASE_URL=https://huddle.vercel.app

# ---------- Kiosk ----------
# Optional shared secret. If set, the ESP32 sends it as x-kiosk-key and the web kiosk needs /kiosk?key=...
# KIOSK_KEY=pick-a-long-random-string

# ---------- Money ----------
# demo (default): "Add $5 test money" buttons. coinbase: Coinbase Onramp deposits.
# MONEY_MODE=demo

# Coinbase Developer Platform: portal.cdp.coinbase.com > API Keys > Secret API key (Ed25519 recommended).
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# Wallet secret (portal > Server Wallet). Needed to create/use the treasury wallet and for on-chain payouts.
# CDP_WALLET_SECRET=
# Optional: receive deposits at an address you already control instead of the CDP server wallet.
# TREASURY_ADDRESS=0x...
# Optional: name of the CDP server wallet account used as treasury.
# CDP_TREASURY_ACCOUNT_NAME=live-lines-treasury

# true (default) = sandbox: partnerUserRef gets the "sandbox-" prefix, no real charge.
# false = REAL MONEY. Read the README "Real money" section first.
# COINBASE_SANDBOX=true

# v2 (default) = POST /platform/v2/onramp/sessions. v1 = session token + pay.coinbase.com URL.
# COINBASE_ONRAMP_API=v2

# onchain = cash-outs send real USDC on Base from the treasury (only when COINBASE_SANDBOX=false).
# PAYOUTS=off

# --- Solana (devnet) ---------------------------------------------------------
# solana = each game can pick Solana money on the box (demo money stays the default).
# MONEY_MODE=solana
# vault = each party's money sits in the huddle_vault program and settles on chain.
# SETTLEMENT=vault
# SOLANA_TREASURY_SECRET_KEY=        (JSON byte array or base58; never commit it)
# USDC_MINT=                         (the 6-decimal test USDC mint on devnet)
# SOLANA_RPC_URL=https://api.devnet.solana.com
# HUDDLE_VAULT_PROGRAM_ID=GRpABdrQhDya9n2zuf19w2idbL3CRSqmWYTJs52taRHu

# --- QuickNode ---------------------------------------------------------------
# Shared secret for a Stream (x-huddle-token header, or the Stream's security token).
# QUICKNODE_STREAM_TOKEN=
# Security token of a QuickNode Webhook (Solana Wallet Activity Monitor on the treasury's USDC account).
# QUICKNODE_WEBHOOK_TOKEN=

# --- ElevenLabs --------------------------------------------------------------
# Turns on the announcer's voice (TTS) on the speaker, the TV and the box preview.
# ELEVENLABS_API_KEY=
